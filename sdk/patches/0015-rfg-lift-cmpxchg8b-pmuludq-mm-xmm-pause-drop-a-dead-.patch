+            w = self.width(d)
+            parts = " ".join(f"_r.u64[{i}] = (uint64_t)_d.u32[{2*i}] * (uint64_t)_s.u32[{2*i}];"
+                             for i in range(w // 64))
+            return [f"{{ V128 _s = {self.vread(s, w)}; V128 _d = {self.vread(d)}; V128 _r = _d; {parts} {self.vwrite(d, '_r')} }}"]
         if m == "psadbw":
             w = self.width(d)
             groups = w // 64
